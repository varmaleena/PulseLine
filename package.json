{
  "name": "pulseline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node --watch dist/backend/server.js",
    "start": "node dist/backend/server.js",
    "build": "node scripts/build.mjs",
    "test": "tsc && node --test dist/tests/*.test.js",
    "check": "tsc --noEmit",
    "test:browser": "node scripts/browser-check.mjs",
    "test:live": "npm run build && node scripts/live-browser-check.mjs",
    "verify:live": "tsc && node dist/scripts/verify-live.js",
    "spike": "tsc && node dist/scripts/urgency-spike.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdfkit": "^0.20.2",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/pdfkit": "^0.17.6",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3"
  }
}
