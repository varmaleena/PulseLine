PORT=8080
# Copy to .env and supply the key locally. Never put it in client code.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=hackathon-c78aa
STORE=local
DATA_DIR=data
STAFF_PIN=
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
MAX_SESSIONS=20
RETENTION_DAYS=30
TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
TRANSLATE_MODEL=gemini-3.5-live-translate-preview
URGENCY_MODEL=gemini-3.8-live
TTS_MODEL=gemini-3.8-flash-tts
# acoustic (default, nonclinical intensity signal) or gemini (experimental)
URGENCY_MODE=acoustic
# native streams Live Translate audio; tts uses dedicated Flash TTS per turn
SPEECH_MODE=native
